# Copy to .env.prod and fill in secrets before running docker compose -f docker-compose.prod.yml up -d

DATABASE_URL=ecto://parlor:parlor@postgres:5432/parlor_prod
SECRET_KEY_BASE=change-me-run-mix-phx-gen-secret
PARLOR_SIGNING_SECRET=change-me
PARLOR_API_KEY=change-me
PARLOR_ADMIN_USER=admin
PARLOR_ADMIN_PASSWORD=change-me
PHX_HOST=localhost
PHX_SERVER=true
PORT=4000

# Optional: multi-node clustering (requires shared RELEASE_COOKIE on every instance)
# DNS_CLUSTER_QUERY=
# RELEASE_COOKIE=
